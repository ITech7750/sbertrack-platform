# Copy to .env and fill in real values before deploying anywhere but a local
# machine. Every variable has a dev-only default in application.yml /
# docker-compose.yml — this file documents what to override for production.

# --- Database ---
POSTGRES_DB=sbertrack
POSTGRES_USER=sbertrack
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Backend / ports ---
BACKEND_PORT=8080
FRONTEND_PORT=3000

# --- Auth (JWT) ---
# Required in production: a random secret at least 32 bytes long.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-32-byte-secret
JWT_TTL_HOURS=24

# --- File uploads ---
UPLOAD_DIR=/app/uploads
UPLOAD_MAX_SIZE_BYTES=20971520

# --- AI mentors (optional) ---
# Explicit selection: mock, anthropic, gemini, cloud, local. Keys alone do not select a provider.
AGENT_ACTIVE_PROFILE=mock
# Optional: retries exhausted on transient errors only. May transmit context to another provider.
AGENT_FALLBACK_PROFILE=
AGENT_MAX_INPUT_CHARS=32000
AGENT_MAX_HISTORY_MESSAGES=20
AGENT_CLOUD_BASE_URL=
AGENT_CLOUD_API_KEY=
AGENT_CLOUD_MODEL=
AGENT_CLOUD_TOKEN_LIMIT_FIELD=max_tokens
# Docker Desktop: use host.docker.internal to reach a model running on the host.
AGENT_LOCAL_BASE_URL=http://host.docker.internal:8000/v1
AGENT_LOCAL_API_KEY=
AGENT_LOCAL_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Gemini credentials (used only when its profile is selected).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Email notifications (optional) ---
# Leave SPRING_MAIL_HOST empty to log notifications instead of sending them.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# Most providers (Gmail, SES, Mailgun) need both of these left at their
# defaults (true). Only turn them off for a plaintext internal relay that
# doesn't speak STARTTLS/AUTH.
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS=true
SBERTRACK_NOTIFICATION_FROM_EMAIL=noreply@sbertrack.local
